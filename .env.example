# Copie para .env: cp .env.example .env

# --- Desenvolvimento local (venv Python 3.12, Postgres exposto na porta 5432) ---
DATABASE_URL=postgresql+asyncpg://ecotrack:ecotrack@localhost:5432/ecotrack

# --- Dentro do Docker Compose (já definido em docker-compose.yml) ---
# DATABASE_URL=postgresql+asyncpg://ecotrack:ecotrack@ecotrack-db:5432/ecotrack

# OpenWeather Air Pollution API — cadastre-se em https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Origens permitidas para CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Limite de requisições por minuto na rota de qualidade do ar (free tier: 60 RPM)
THROTTLE_RPM=60
